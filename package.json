{
  "name": "onequeue-action",
  "version": "1.0.0",
  "private": true,
  "description": "OneQueue Scan: GitHub Action for OneQueue",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "esbuild src/main.ts --bundle --platform=node --target=node24 --format=esm --outfile=dist/main.js --legal-comments=none",
