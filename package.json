{
  "name": "onequeue-action",
  "version": "1.0.0",
  "private": true,
  "description": "OneQueue Scan: GitHub Action for OneQueue by Keytrion Labs",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "esbuild src/main.ts --bundle --platform=node --target=node24 --format=esm --outfile=dist/main.js --legal-comments=none",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "esbuild": "0.28.2",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
